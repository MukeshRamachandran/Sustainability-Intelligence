# Operator checklist. The running API reads services/main-api/.env.
# Do not put real passwords, session secrets, or database URLs in Git.

APP_ENV=production

DATABASE_URL=
POSTGRES_DB=microcosm
POSTGRES_USER=microcosm_app
POSTGRES_PASSWORD=

SECRET_KEY=
CSRF_SECRET=

PASSWORD_MIN_LENGTH=12
ALLOWED_ORIGINS=https://sustainability.kct.ac.in

# Optional overrides used by deployment/scripts.
PUBLIC_BASE_URL=https://sustainability.kct.ac.in
BACKUP_DIR=/var/backups/kcosmos
BACKUP_RETENTION_DAYS=14
