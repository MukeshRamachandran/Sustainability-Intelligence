FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /app

RUN groupadd --system --gid 10001 microcosm \
    && useradd --system --uid 10001 --gid microcosm --home-dir /app microcosm \
    && mkdir -p /ms-playwright \
    && chown -R microcosm:microcosm /app /ms-playwright

COPY pyproject.toml README.md ./
COPY app ./app

RUN pip install --upgrade "pip==25.2" \
    && pip install ".[aeron-worker]" \
    && python -m playwright install --with-deps chromium \
    && chown -R microcosm:microcosm /app /ms-playwright

USER microcosm

CMD ["python", "-m", "app.environment.worker"]
