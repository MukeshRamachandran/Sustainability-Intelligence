# The only environment file. Copy to services/main-api/.env and fill it in.
# The API, environment worker, Compose, and backup scripts all read that file.
# Never commit .env.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_DB=microcosm
POSTGRES_USER=microcosm_app
POSTGRES_PASSWORD=

# Full URL. Compose does not expand variables inside this file.
# Example shape (replace the password; do not leave this comment as the value):
# postgresql+psycopg://microcosm_app:YOUR_PASSWORD@postgres:5432/microcosm
DATABASE_URL=

PUBLIC_BASE_URL=https://sustainability.kct.ac.in
INSTITUTION_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=https://sustainability.kct.ac.in

# Session signing secret. Minimum 32 characters in production.
SECRET_KEY=
CSRF_SECRET=

SESSION_COOKIE_NAME=microcosm_session
CSRF_COOKIE_NAME=microcosm_csrf
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

EVIDENCE_ROOT=/data/evidence
EVIDENCE_STORAGE_DIR=/data/evidence/clean
MAX_UPLOAD_BYTES=10485760
MAX_EVIDENCE_FILE_SIZE_BYTES=10485760
ALLOWED_EVIDENCE_TYPES=application/pdf,image/png,image/jpeg

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Leave unset to hide /docs and /openapi.json in production.
# OPENAPI_ENABLED=false

# Aeron ingestion worker (REST API v1, Bearer API key). Supply the real key
# only in .env, never in Git. The browser never sees it: only the worker sends it.
AERON_STATION_ID=b1ce41c2-586a-4a26-9382-9d8bfe757e78
AERON_API_BASE_URL=https://live3.aeronsystems.com/api/v1
AERON_API_KEY=
# Aeron's latest reading changes about every 7 minutes. 300 s = 288 of the
# 10000 requests Aeron allows per day. Values are clamped to 120-3600.
AERON_POLL_INTERVAL_SECONDS=300
AERON_CONNECT_TIMEOUT_SECONDS=5
AERON_READ_TIMEOUT_SECONDS=15
AERON_MAX_ATTEMPTS=3

# Host backup location used by deployment/scripts/backup-db.sh.
BACKUP_DIR=/var/backups/kcosmos
BACKUP_RETENTION_DAYS=14
