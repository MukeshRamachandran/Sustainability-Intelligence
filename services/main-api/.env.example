APP_ENV=development
DATABASE_URL=postgresql+psycopg://microcosm_app:microcosm_dev_only@postgres:5432/microcosm
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
INSTITUTION_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=development-only-change-me
CSRF_SECRET=development-csrf-change-me
SESSION_COOKIE_NAME=microcosm_session
CSRF_COOKIE_NAME=microcosm_csrf
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
EVIDENCE_ROOT=/data/evidence
MAX_UPLOAD_BYTES=10485760
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12

# Aeron ingestion worker only (python -m app.environment.worker).
# The worker reads these from the process environment, never from this file;
# supply real values through a secret store.
AERON_STATION_ID=b1ce41c2-586a-4a26-9382-9d8bfe757e78
AERON_INTERNAL_BASE_URL=https://live3.aeronsystems.com/api
AERON_DASHBOARD_URL=https://live3.aeronsystems.com/dashboard
AERON_REGION=india
AERON_USERNAME=airquality@kct.ac.in
AERON_PASSWORD=b8b464c0fc
AERON_POLL_INTERVAL_SECONDS=300
AERON_HTTP_TIMEOUT_SECONDS=15
AERON_LOGIN_TIMEOUT_SECONDS=30
