APP_ENV=development
DATABASE_URL=postgresql+psycopg://microcosm_app:microcosm_dev_only@postgres:5432/microcosm
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
INSTITUTION_TIMEZONE=Asia/Kolkata
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=development-only-change-me
CSRF_SECRET=development-csrf-change-me
SESSION_COOKIE_NAME=microcosm_session
CSRF_COOKIE_NAME=microcosm_csrf
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
EVIDENCE_ROOT=/data/evidence
MAX_UPLOAD_BYTES=10485760
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=12
