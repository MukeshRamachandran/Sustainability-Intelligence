APP_ENV=production
LOG_LEVEL=INFO

AERON_PUBLIC_API_URL=https://api.aeronsystems.com/v3
AERON_API_KEY=replace_with_secret
AERON_STATION_ID=replace_with_station_id
AERON_FALLBACK_ENABLED=false
AERON_FALLBACK_API_URL=
AERON_SESSION_COOKIE=
AERON_SYNC_ENABLED=true
AERON_SYNC_INTERVAL_SECONDS=60
AERON_REQUEST_TIMEOUT_SECONDS=10
AERON_RETRY_COUNT=3
AERON_TIMESTAMP_CORRECTION_MINUTES=330
AERON_INTERNAL_SYNC_TOKEN=replace_with_long_random_secret
AERON_ALLOWED_ORIGINS=

DATABASE_URL=postgresql://microcosm_app:replace_with_secret@postgres:5432/microcosm
AERON_ALLOW_SQLITE=false
